---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';


---

<Layout>
	<div id="top-logo">
		<h1>BIG BROTHER</h1>
	</div>

	<div id="page-content">
		<form id="room-join-form" action="/enter_waiting_room.json" method="post">
			<input type="text" id="game-pin" name="game-pin" placeholder="Game PIN">
			<input type="text" id="player-name" name="player-name" placeholder="Name">
			<!-- https://codepen.io/giana/pen/BZaGyP -->
			<button type="submit" id="room-join-button">JOIN</button>
		</form>
		<a onclick="hostStartEvent()" id="make-room-link">Are you the host? Start new session now.</a>

	</div>
</Layout>



<style>
	#make-room-link {
		color: #FFFFFF;
		text-decoration: none;
		border-bottom: 2px solid #FFF;
		padding-bottom: 2px;
		font-family: 'Karla', sans-serif;
		font-weight: 600;
		letter-spacing: 0.05em;
		transition: all 0.3s ease;
	}

	#make-room-link:hover {
		color: #FFDE59;
		border-bottom-color: #FFDE59;
		padding-bottom: 4px;
	}

	#room-join-form {

		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 20px;
	}

	#room-join-button {
		max-width: 200px;
		transition: 0.25s; 
		background-color: #1A1A1A;   
		color: #FFFFFF;      
		position: relative;     

        
		border: none;
		border-radius: 5px;  
		padding: 0.75rem 1.5rem; 

		transition: all 0.3s ease;
		text-transform: uppercase;  

		font-family: "Chakra Petch", sans-serif;
		font-weight: 500;
		font-style: normal;
		margin: 10px;
		font-size: 1.5em;
	}


		
	#room-join-button::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;

		background: url('squares.avif');
		background-size: cover;
		opacity: 0.8;

		mask-image: radial-gradient(circle at center, transparent 50%, black 100%);
		-webkit-mask-image: radial-gradient(circle at center, transparent 50%, black 100%);
		pointer-events: none; 
		z-index: 0; 
	}

	#room-join-button:hover, #room-join-button:focus {

		box-shadow: 0 0 12px #FFDE59, 0 0 24px #FFDE59;
		transform: scale(1.05);

	}

</style>

<script is:inline>
	const hostStartEvent = async () => {
		const response = await fetch('/create_new_session.json', {method: 'POST', headers: { 'Content-Type': 'application/json' } });
		const data = await response.json();
		if (data.roomID) {
			window.location.href = `/results?roomCode=${data.roomID}`;
		}

	}

