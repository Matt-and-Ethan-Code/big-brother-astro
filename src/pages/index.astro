</Layout> -->

<head>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Chakra+Petch:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Karla:ital,wght@0,200..800;1,200..800&family=Rubik+Mono+One&display=swap" rel="stylesheet">
</head>


<body>
	<h1>BIG BROTHER</h1>

	<div id="page-content">
		<form id="room-join-form">
			<input type="text" id="game-pin" name="game-pin" placeholder="Game PIN">
			<!-- https://codepen.io/giana/pen/BZaGyP -->
			<button type="submit" id="room-join-button">JOIN</button>
		</form>
		<button onclick="hostStartEvent()">Are you the host? Start new session now.</button>

	</div>
</body>

<style>
	input {
		font-family: "Karla";
		line-height: 1;
		width: 300px;
		height: 40px;
		padding: 10px;
		font-size: 1.5em;
	}
	#page-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		height: 70%;
	}

	h1 {
		font-family: 'Rubik Mono One', monospace;
		font-weight: 400;
		font-style: normal;
	}

	#room-join-form {

		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 20px;
	}

	#room-join-button {
		max-width: 200px;

		background: none;
		border: 2px solid;
		font: inherit;
		line-height: 1;
		margin: 0.5em;
		padding: 1em 2em;

		color: #a972cb;
		transition: 0.25s;

		font-family: "Chakra Petch", sans-serif;
		font-weight: 500;
		font-style: normal;
		height: 100%;
	}

	#room-join-button:hover, #room-join-button:focus {
		/* box-shadow: inset 0 0 0 hue-rotate(,45deg) */
		border-color: #cb72aa;
		color: #fff;
		box-shadow: inset 0 0 0 2em #cb72aa;

	}

	html, body {

		margin: 0;
		padding: 0;
		min-height: 100%;
		height: 100%;
		/* height: 100vh; */
	}
</style>

