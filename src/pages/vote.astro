---
import Layout from "../layouts/Layout.astro";
import playersJson from "../../public/players.json";

type Player = { name: string, age: number, state: string, occupation: string, description: string, img: string}
const players = playersJson as Player[];
---

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const Sortable = (await import('sortablejs')).default;
    const player_list = document.querySelector('ul');
    if (!player_list) throw new Error('no player list');
    const sortable = new Sortable(player_list, {
      handle: '.handle',
      animation: 150,
    })
    sortable.option('onEnd', () => {
      const order = sortable.toArray();

      order.forEach((element, i) => {
        const playerCard = document.getElementById(element);
        const eliminationSpan = playerCard?.getElementsByClassName('eviction-number');
        const firstSpanMatch = eliminationSpan?.item(0);
        if (eliminationSpan && firstSpanMatch) {
          firstSpanMatch.textContent =               i + 1 < 17 ? 
                (i == 0 ? "1 (First out)" : String(i + 1)) :  
                "17 (Winner)";
        }
      })
    })
  })

  function onSubmit(this: HTMLButtonElement) {
    const player_list = document.querySelector('ul')!
    const player_names_in_order = [];
    for (const player_element of player_list.children) {
      const player_name = player_element.id;
      player_names_in_order.push(player_name);
    }

    const queryParams = (() => {
      const raw_params = new URLSearchParams(window.location.search);
      const game_id = raw_params.get('gameId');
      const username = raw_params.get('username')
      if (!game_id) throw new Error('no game id');
      if (!username) throw new Error('no username');
      return {game_id, username}
    })();
    console.log(queryParams)
    console.log(player_names_in_order)

    fetch('/handle_create_room.json', {
      method: 'POST',
      body: JSON.stringify({
        username: queryParams.username,
        game_id: queryParams.game_id,
        rankings: player_names_in_order
      }),
      redirect: 'follow'
    })

  }
  document.getElementById('submit-rankings-button')!.addEventListener('click', onSubmit)
</script>
<style>
  html,body {
    overflow-y: auto;
  }
  h3 {
    font-family: 'Rubik Mono One', monospace;
    font-weight: 400;
    font-style: normal;
  }

</style>
<Layout>
  <ul>
    {players.map((player, i)=>
      <li data-id={player.name} class="p-1 grid my-1 mx-2 border-2 border-solid rounded-lg box-border bg-gray-900/50" style="grid-template-columns: 40fr 50fr 10fr" id={player.name}>
        <img class="rounded-lg" src={player.img}/>
        <div class="ml-4 flex flex-col justify-between">
          <div>
              <h3 class="text-3xl font-bold p-2.5 text-white">{player.name}</h3>
              <div class="p-2.5">
                <h4 class="text-2xl font-bold text-white/70">{player.age} • {player.state}</h4>
                <h4 class="text-2xl font-bold text-white/70">{player.occupation}</h4>
              </div>
              <p>{player.description}</p>
          </div>
          <p class="text-2xl font-semibold text-white/80 p-2.5">Predicted Eviction: #
            <span class="eviction-number font-bold">
              {i + 1 < 17 ? 
                (i == 0 ? "1 (First out)" : String(i + 1)) :  
                "17 (Winner)"}
            </span>
          </p>
        </div>
        <div class="flex items-center justify-center handle text-white">
          <span class="material-symbols-outlined">
            drag_indicator
          </span>
        </div>
      </li>)}
  </ul>
  <button id="submit-rankings-button" class="text-5xl border-2 rounded-lg bg-white px-2 py-1 w-full mb-4 max-w-full min-w-full">Submit Ranking</button>
</Layout>

<style>

  #submit-rankings-button::after {
    background: none;
  }
</style>