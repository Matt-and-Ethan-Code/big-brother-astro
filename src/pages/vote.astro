---
import Layout from "../layouts/Layout.astro";
import playersJson from "./public/players.json";
import Sortable from 'sortablejs';
/* Currently just a list of players' names */
type Player = { name: string, img: string}
const players = playersJson as Player[];

---

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const Sortable = (await import('sortablejs')).default;
    const player_list = document.querySelector('ul');
    if (!player_list) throw new Error('no player list');
    new Sortable(player_list, {
      animation: 150,
    })
  })

  function onSubmit(this: HTMLButtonElement) {
    const player_list = document.querySelector('ul')!
    const player_names_in_order = [];
    for (const player_element of player_list.children) {
      const player_name = player_element.id;
      player_names_in_order.push(player_name);
    }

    console.log(player_names_in_order)
  }
  document.getElementById('submit-button')!.addEventListener('click', onSubmit)
</script>
<style>

html, body {
  height: auto;
  overflow-y: auto
}
.player {
    padding: .5rem 0rem;
    font-size: 1.5rem;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
}
.player-name {
  margin: 0;
}
.player-list {
    list-style: none;
    display:flex;
    align-items:center;
    flex-direction:column;
}
</style>

<Layout>
  <ul class="player-list">
    {players.map(player=>
      <li class="player" id={player.name}>
        <img src={player.img} height="100"/>
        <h3 class="player-name">{player.name}</h3>
      </li>)}
  </ul>
  <button id="submit-button">Submit</button>
</Layout>

