---
import Layout from "../layouts/Layout.astro";
import players from "./public/players.json";
import Sortable from 'sortablejs';
/* Currently just a list of players' names */
const playerNames: string[] = players;

---

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const Sortable = (await import('sortablejs')).default;
    const player_list = document.querySelector('ul');
    if (!player_list) throw new Error('no player list');
    new Sortable(player_list, {
      animation: 150,
    })
  })
</script>
<style>
.player {
    padding: .5rem 0rem;
    font-size: 1.5rem;
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:row;
}
.player-list {
    list-style: none;
    display:flex;
    align-items:center;
    flex-direction:column;
}
</style>

<Layout>
  <ul class="player-list">
    {playerNames.map(name=><li class="player" id={name}>{name}</li>)}
  </ul>
</Layout>

