---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import { createClient } from 'redis';
import { score, ACTUAL, REMAINING, MAX_SCORE } from '../util/score';
export const prerender = false;  // page is SSR, not SSG so it can be dynamic
const roomCode = Astro.url.searchParams.get('roomCode');
if (!roomCode) {
  return new Response(null, {
    status: 500,
    statusText: `Bad roomCode: '${roomCode}''`
  });
}

const path_name = `rediss://default:${import.meta.env.UPSTASH_TOKEN}@${import.meta.env.UPSTASH_ENDPOINT}:${import.meta.env.UPSTASH_PORT}`
console.log("PATH NAME: ", path_name)

const client = createClient({
    url: path_name
}).on("error", console.error)
try {
    await client.connect();
} catch(e) {
    console.log("ERROR! ", e);
}

let entry_names: string[] = [];
for await (const entries of client.scanIterator({ MATCH: '*:*'})) {
	for (const whatever of entries) {
		entry_names.push(whatever);
	}
}
type Result = {
	username: string,
	predicted_order: string[],
	score: ReturnType<typeof score>,
}
const results: Result[] = [];
for (const entry_name of entry_names) {
	const semicolon_index = entry_name.lastIndexOf(':');
	if (semicolon_index == -1) {
		console.warn(`BAD ENTRY NAME: ${entry_name}`);
		continue;
	}

	
	const room_name = entry_name.slice(semicolon_index + 1);
	if (room_name != roomCode) continue;  // this one is for a different room code
	const username = entry_name.slice(0, semicolon_index);

	const user_order: string[] | null = JSON.parse(await client.get(entry_name) || 'null');
	if (!user_order || !Array.isArray(user_order)) {
		console.warn(`BAD USER SCORES: ${user_order}`);
		continue;
	}
	results.push({
		username,
		predicted_order: user_order,
		score: score(user_order)
	})
}
// sort in descending score
results.sort((a, b) => b.score.total - a.score.total)
const last_out_index = ACTUAL.length - 1;
const with_last_out_style = (style: string, i: number) => i == last_out_index ? style + " border-r-2" : style;
---

<Layout>
	<div id="top-logo">
		<h1>BIG BROTHER</h1>
	</div>
	<div id="page-content" class="text-white/70">
		<div id="room-code-container">
			<span>Room Code </span>
			<span id="room-code">{roomCode}</span>
		</div>
		<ul>
			{results.map(result => 
				<li class="border-black border-2 rounded-xl p-4 m-4" style="background: rgba(0,0,0,0.3);">
					<p>{result.username} &nbsp;&nbsp;|&nbsp;&nbsp; <span class="font-bold">{result.score.total}</span> / {MAX_SCORE}</p>
					<div class="w-full overflow-x-auto whitespace-nowrap">
						<table>
							<thead>
								<th class="p-1 pr-2 text-left border-r-2">Place</th>
								{[...ACTUAL, ...REMAINING].map((_, i, arr) => <th class="p-1 text-center">{arr.length - i}</th>)}
							</thead>
							<tbody>
								<tr>
									<td class="p-1 pr-2 text-left border-r-2">Actual</td>
									{[...ACTUAL, ...REMAINING].map((player, i) => <td class={with_last_out_style("p-1 text-center", i)}>{player}</td>)}
								</tr>
								<tr>
									<td class="p-1 pr-2 text-left border-r-2">Predicted</td>
									{result.predicted_order.map((player, i) => <td class={with_last_out_style("p-1 text-center", i)}>{player}</td>)}
								</tr>
								<tr>
									<td class="p-1 pr-2 text-left border-r-2">Distance</td>
									{result.predicted_order.map((player, i) => {
										const hi = result.score.per_person[player];
										return <td class={with_last_out_style("p-1 text-center", i)}>{hi.distance}</td>;
									})}
								</tr>
								<tr>
									<td class="p-1 pr-2 text-left border-r-2">Points</td>
									{result.predicted_order.map((player, i) => {
										const hi = result.score.per_person[player];
										if (hi.contribution == 0) {
											return <th></th>
										}
										return <td class={with_last_out_style("p-1 text-center", i)}>{hi.contribution}</td>
									})}
								</tr>
							</tbody>
						</table>
					</div>
				</li>)}
		</ul>
	</div>
</Layout>
